{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instalar Capri",
  "version": "0.1.0",
  "identifier": "com.capri.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Capri",
        "width": 820,
        "height": 540,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
